# 배포용 설정 (docker compose가 이 파일의 복사본 `.env`를 읽는다). 실제 값은 .env에만 — git에 올리지 않는다.

# 백엔드 도메인 (Caddy가 이 도메인으로 HTTPS 인증서를 자동 발급). 예: api.example.com 또는 <공인IP>.sslip.io
API_DOMAIN=

# 프론트(Vercel) 주소. 쉼표로 여러 개 (미리보기 배포를 쓰면 그 주소도 추가)
CORS_ORIGINS=https://cloudle.vercel.app

# SSAFY GMS 키 (비워 두면 LLM 없이 오프라인 모드)
GMS_KEY=
TOKEN_BUDGET=70000
RATE_LIMIT_PER_MIN=20
