# ── LLM: SSAFY GMS 키 (GPT, GMS 프록시 경유) ── 비워두면 오프라인(규칙·발췌) 모드
# 실제 키는 backend/.env.local 또는 이 폴더의 .env.local에 넣는다 (git 무시됨)
GMS_KEY=
# 저렴하면서 근거 기반 JSON 답변을 잘 따르는 모델
LLM_MODEL=gpt-4o-mini

# ── 토큰 절약 ──
TOKEN_BUDGET=70000          # 누적 토큰 상한. 넘으면 자동으로 오프라인 모드
LLM_STAGES=generate         # LLM을 쓸 단계: query,select,generate,vision (기본: 최종 답변만)
LLM_MAX_OUTPUT_TOKENS=450
EVIDENCE_CHARS=600          # 프롬프트에 넣는 근거 1건 최대 길이
EMBEDDING_PROVIDER=local    # local(내장, 토큰 0) | openai

# ── RAG 설정 ──
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
USE_MMR=false

# ── 외부 데이터 (선택) ──
OPENAQ_API_KEY=
WIKI_USER_AGENT=CLOUDLE/0.2 (https://lab.ssafy.com/s16/a11/ai_day/CLOUDLE; SSAFY education project)

# ── 서버 (게이트웨이 뒤 내부 서비스) ──
RATE_LIMIT_ENABLED=false    # 요청 제한은 api-gateway가 맡는다
SESSION_TTL_HOURS=24
CORS_ORIGINS=http://localhost:3000
