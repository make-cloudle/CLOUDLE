# CLOUDLE API Gateway
PORT=4000
# 내부 Python RAG 서비스 (backend/rag-service)
RAG_SERVICE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# 개발 중 같은 와이파이의 휴대폰(LAN IP) 접속 허용 (production 기본값 false)
ALLOW_LAN_ORIGINS=true
RATE_LIMIT_PER_MIN=20
# 구름 광장 개발용 신원: 프론트 포트:닉네임
COMMUNITY_IDENTITIES=3000:지구미,3001:예나
