# ── LLM (OpenAI 호환: OpenAI 또는 SSAFY GMS) ── 비워두면 오프라인 모드
OPENAI_API_KEY=
# SSAFY GMS 예: https://gms.ssafy.io/gmsapi/api.openai.com/v1
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── RAG 설정 ──
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
USE_MMR=false

# ── 외부 데이터 (선택) ──
OPENAQ_API_KEY=
WIKI_USER_AGENT=CLOUDLE/0.1 (SSAFY AI core project; https://lab.ssafy.com/s16/a11/ai_day/CLOUDLE)

# ── 서버 ──
RATE_LIMIT_PER_MIN=20
SESSION_TTL_HOURS=24
CORS_ORIGINS=http://localhost:3000
